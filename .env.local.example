# Supabaseクライアント（必須）
# 値の取得方法は docs/setup.md §1 を参照
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側処理（通知送信・管理画面集計・CSVエクスポート）用（必須）
# RLSを無視する強い権限のため、クライアントに漏れないよう扱いに注意
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API（必須。AIトレーニング提案・改善案・週次レポート生成に使用）
GEMINI_API_KEY=
# 使用するモデル名（コード側にデフォルト値は持たせていないため必須。未設定時はエラーになる）
GEMINI_MODEL=gemini-3.5-flash-lite

# Web Push（VAPID、必須。`npx web-push generate-vapid-keys` で生成）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google OAuth（Calendar スコープ含む、必須）
# 値の取得方法は docs/setup.md §3 を参照
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase pg_cron → /api/notifications/dispatch の認証用（必須）
# Supabase Vaultにも同じ値を `cron_secret` として保存する（docs/setup.md参照）
CRON_SECRET=

# Google Tag Manager コンテナID（任意。未設定でもアプリは動作する）
NEXT_PUBLIC_GTM_CONTAINER_ID=
